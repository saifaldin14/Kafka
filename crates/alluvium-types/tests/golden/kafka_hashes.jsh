// Computes Kafka 4.4.0's Utils.murmur2 and BuiltInPartitioner.partitionForKey over
// deterministic inputs, for the golden files beside this script. Run generate.sh.
//
// Inputs come from SplitMix64 so the Rust tests can rebuild them without storing
// them: an input of at most `max` bytes has length next() mod (max + 1), unsigned,
// then one byte per position, the low 8 bits of next().
import java.io.PrintWriter;
import org.apache.kafka.clients.producer.internals.BuiltInPartitioner;
import org.apache.kafka.common.utils.Utils;

long state;

long next() {
    state += 0x9E3779B97F4A7C15L;
    long z = state;
    z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
    z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
    return z ^ (z >>> 31);
}

byte[] input(int max) {
    byte[] data = new byte[(int) Long.remainderUnsigned(next(), max + 1)];
    for (int i = 0; i < data.length; i++) data[i] = (byte) next();
    return data;
}

state = 1;
try (PrintWriter out = new PrintWriter("/w/murmur2.txt")) {
    out.println("# Kafka 4.4.0 Utils.murmur2 of 10000 inputs of 0 to 1024 bytes from SplitMix64 state 1.");
    out.println("# Generated by generate.sh (kafka_hashes.jsh); one hash per line, in input order.");
    for (int i = 0; i < 10000; i++) out.println(Utils.murmur2(input(1024)));
}

state = 2;
try (PrintWriter out = new PrintWriter("/w/partition_for_key.txt")) {
    out.println("# Kafka 4.4.0 BuiltInPartitioner.partitionForKey of 10000 keys of 0 to 64 bytes from");
    out.println("# SplitMix64 state 2, each followed by a partition count of 1 + next() mod 64.");
    out.println("# Generated by generate.sh (kafka_hashes.jsh); one `count partition` pair per line.");
    for (int i = 0; i < 10000; i++) {
        byte[] key = input(64);
        int partitions = 1 + (int) Long.remainderUnsigned(next(), 64);
        out.println(partitions + " " + BuiltInPartitioner.partitionForKey(key, partitions));
    }
}
/exit
