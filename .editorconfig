# Editor settings for every editor that reads EditorConfig. Rust indentation and line
# length match rustfmt's defaults, so saving never fights `cargo fmt`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2
